@page "/not-found"
@layout MainLayout

<PageTitle>Not Found - SamurAI Council</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: calc(100vh - 200px);">
    <MudPaper Class="pa-8" Elevation="4" Style="text-align: center; max-width: 500px;">
        <MudAvatar Color="Color.Warning" Size="Size.Large" Class="mb-4" Style="width: 80px; height: 80px;">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Style="font-size: 3rem;" />
        </MudAvatar>

        <MudText Typo="Typo.h4" Class="mb-2" Color="Color.Warning">404</MudText>

        <MudText Typo="Typo.h6" Class="mb-2">Page Not Found</MudText>

        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
            Sorry, the content you are looking for does not exist.
            It may have been moved or deleted.
        </MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Home"
                   Href="/">
            Return Home
        </MudButton>
    </MudPaper>
</MudContainer>

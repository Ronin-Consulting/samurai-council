@if (Rankings == null || Rankings.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Icon="@Icons.Material.Filled.Info">
        No rankings available
    </MudAlert>
}
else
{
    <MudStack Spacing="2">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                <MudIcon Icon="@Icons.Material.Filled.HowToVote" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                Stage 2: Peer Review
            </MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">
                @Rankings.Count models ranked
            </MudChip>
        </MudStack>

        <MudTabs @bind-ActivePanelIndex="_selectedIndex"
                 Elevation="0"
                 Rounded="true"
                 ApplyEffectsToContainer="true"
                 PanelClass="pa-3"
                 MinimumTabWidth="100px">
            @foreach (var (ranking, index) in Rankings.Select((r, i) => (r, i)))
            {
                <MudTabPanel Text="@GetShortModelName(ranking.Model)">
                    <TabContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAvatar Size="Size.Small" Color="@GetProviderColor(ranking.Model)">
                                @GetProviderInitial(ranking.Model)
                            </MudAvatar>
                            <span>@GetShortModelName(ranking.Model)</span>
                        </MudStack>
                    </TabContent>
                    <ChildContent>
                        <MudStack Spacing="2">
                            <MudPaper Class="pa-4" Elevation="0" Style="background-color: var(--mud-palette-background-gray);">
                                <MarkdownRenderer Content="@DeAnonymize(ranking.Ranking)" />
                            </MudPaper>

                            @if (ranking.ParsedRanking.Count > 0)
                            {
                                <MudPaper Class="pa-3" Elevation="1">
                                    <MudText Typo="Typo.body2" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                                        Extracted Ranking
                                    </MudText>
                                    <MudStack Spacing="1">
                                        @foreach (var (item, rank) in ranking.ParsedRanking.Select((item, i) => (item, i + 1)))
                                        {
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudChip T="string"
                                                         Size="Size.Small"
                                                         Color="@GetRankColor(rank)"
                                                         Variant="Variant.Filled">
                                                    #@rank
                                                </MudChip>
                                                <MudText Typo="Typo.caption">@DeAnonymizeLabel(item)</MudText>
                                            </MudStack>
                                        }
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    </ChildContent>
                </MudTabPanel>
            }
        </MudTabs>

        @if (AggregateRankings != null && AggregateRankings.Count > 0)
        {
            <MudPaper Class="pa-3" Elevation="2">
                <MudText Typo="Typo.body2" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Leaderboard" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                    Aggregate Rankings
                </MudText>
                <MudSimpleTable Hover="true" Style="background-color: transparent;">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Model</th>
                            <th style="text-align: right;">Average Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (rank, index) in AggregateRankings.Select((r, i) => (r, i)))
                        {
                            <tr>
                                <td>
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="@GetRankColor(index + 1)"
                                             Variant="Variant.Filled">
                                        #@(index + 1)
                                    </MudChip>
                                </td>
                                <td>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudAvatar Size="Size.Small" Color="@GetProviderColor(rank.Model)">
                                            @GetProviderInitial(rank.Model)
                                        </MudAvatar>
                                        <span>@GetShortModelName(rank.Model)</span>
                                    </MudStack>
                                </td>
                                <td style="text-align: right;">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @rank.AverageRank.ToString("F2")
                                    </MudText>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        }
    </MudStack>
}

@code {
    [Parameter]
    public List<Stage2Ranking>? Rankings { get; set; }

    [Parameter]
    public Dictionary<string, string>? LabelToModel { get; set; }

    [Parameter]
    public List<AggregateRanking>? AggregateRankings { get; set; }

    private int _selectedIndex;

    protected override void OnParametersSet()
    {
        if (Rankings != null && _selectedIndex >= Rankings.Count)
            _selectedIndex = 0;
    }

    private string DeAnonymize(string text)
    {
        if (string.IsNullOrEmpty(text) || LabelToModel == null)
            return text;

        var result = text;
        foreach (var (label, model) in LabelToModel)
        {
            var shortName = GetShortModelName(model);
            result = result.Replace(label, $"**{shortName}**");
        }
        return result;
    }

    private string DeAnonymizeLabel(string label)
    {
        if (LabelToModel != null && LabelToModel.TryGetValue(label, out var model))
        {
            return $"{label} ({GetShortModelName(model)})";
        }
        return label;
    }

    private static string GetShortModelName(string model)
    {
        if (string.IsNullOrEmpty(model))
            return "Unknown";

        var parts = model.Split('/');
        var modelPart = parts.Length > 1 ? parts[^1] : model;

        return modelPart switch
        {
            var m when m.StartsWith("gpt-4") => "GPT-4",
            var m when m.StartsWith("gpt-3.5") => "GPT-3.5",
            var m when m.StartsWith("claude-3-opus") => "Claude Opus",
            var m when m.StartsWith("claude-3-sonnet") => "Claude Sonnet",
            var m when m.StartsWith("claude-3.5-sonnet") => "Claude 3.5",
            var m when m.StartsWith("claude-3-haiku") => "Claude Haiku",
            var m when m.StartsWith("gemini-pro") => "Gemini Pro",
            var m when m.StartsWith("gemini-1.5") => "Gemini 1.5",
            _ => modelPart.Length > 15 ? modelPart[..15] + "..." : modelPart
        };
    }

    private static string GetProviderInitial(string model)
    {
        if (string.IsNullOrEmpty(model)) return "?";

        var provider = model.Split('/').FirstOrDefault()?.ToLower() ?? "";
        return provider switch
        {
            "openai" => "O",
            "anthropic" => "A",
            "google" => "G",
            _ => model[..1].ToUpper()
        };
    }

    private static Color GetProviderColor(string model)
    {
        if (string.IsNullOrEmpty(model)) return Color.Default;

        // Use neutral colors to maintain Ronin theme consistency
        // All providers use Secondary (gray) for a unified look
        var provider = model.Split('/').FirstOrDefault()?.ToLower() ?? "";
        return provider switch
        {
            "openai" => Color.Dark,
            "anthropic" => Color.Primary,
            "google" => Color.Secondary,
            _ => Color.Secondary
        };
    }

    private static Color GetRankColor(int rank)
    {
        return rank switch
        {
            1 => Color.Warning, // Gold
            2 => Color.Default, // Silver
            3 => Color.Tertiary, // Bronze
            _ => Color.Default
        };
    }
}

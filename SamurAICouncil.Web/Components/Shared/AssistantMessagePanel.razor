@if (Message == null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Text">No message data</MudAlert>
}
else if (Message.Loading != null && (Message.Loading.Stage1 || Message.Loading.Stage2 || Message.Loading.Stage3))
{
    <MudStack Spacing="4" AlignItems="AlignItems.Center">
        <LoadingSpinner Size="LoadingSpinner.SpinnerSize.Medium" Message="@GetLoadingMessage()" />

        <MudStack Row="true" Spacing="2" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-4">
            @* Step 1 *@
            <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="@(IsStepActive(1) ? "stage-loading" : "")">
                <MudAvatar Size="Size.Medium"
                           Color="@GetStepColor(1)"
                           Variant="@GetStepVariant(1)">
                    @if (IsStepComplete(1))
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                    }
                    else
                    {
                        <span>1</span>
                    }
                </MudAvatar>
                <MudText Typo="Typo.caption" Color="@GetStepTextColor(1)">Responses</MudText>
            </MudStack>

            <MudDivider Vertical="true" FlexItem="true" Style="height: 2px; width: 40px; align-self: center; margin-top: -20px;" />

            @* Step 2 *@
            <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="@(IsStepActive(2) ? "stage-loading" : "")">
                <MudAvatar Size="Size.Medium"
                           Color="@GetStepColor(2)"
                           Variant="@GetStepVariant(2)">
                    @if (IsStepComplete(2))
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                    }
                    else
                    {
                        <span>2</span>
                    }
                </MudAvatar>
                <MudText Typo="Typo.caption" Color="@GetStepTextColor(2)">Review</MudText>
            </MudStack>

            <MudDivider Vertical="true" FlexItem="true" Style="height: 2px; width: 40px; align-self: center; margin-top: -20px;" />

            @* Step 3 *@
            <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="@(IsStepActive(3) ? "stage-loading" : "")">
                <MudAvatar Size="Size.Medium"
                           Color="@GetStepColor(3)"
                           Variant="@GetStepVariant(3)">
                    @if (IsStepComplete(3))
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                    }
                    else
                    {
                        <span>3</span>
                    }
                </MudAvatar>
                <MudText Typo="Typo.caption" Color="@GetStepTextColor(3)">Synthesis</MudText>
            </MudStack>
        </MudStack>
    </MudStack>
}
else
{
    <MudStack Spacing="3">
        <MudTabs @bind-ActivePanelIndex="_selectedTabIndex"
                 Elevation="0"
                 Rounded="true"
                 ApplyEffectsToContainer="true"
                 PanelClass="pa-3"
                 MinimumTabWidth="100px">
            <MudTabPanel Text="Final Answer"
                         Disabled="@(Message.Stage3 == null)"
                         Icon="@Icons.Material.Filled.AutoAwesome"
                         BadgeColor="Color.Success">
                @* Lazy load - only render when tab is active *@
                @if (_selectedTabIndex == 0)
                {
                    <Stage3Panel Response="@Message.Stage3"
                                 Message="@Message"
                                 Query="@Query"
                                 Timestamp="@Timestamp" />
                }
            </MudTabPanel>
            <MudTabPanel Disabled="@(Message.Stage1 == null || Message.Stage1.Count == 0)"
                         Icon="@Icons.Material.Filled.QuestionAnswer">
                <TabContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="padding-right: 8px;">
                        <span>Responses</span>
                        @if (Message.Stage1?.Count > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                @Message.Stage1.Count
                            </MudChip>
                        }
                    </MudStack>
                </TabContent>
                <ChildContent>
                    @* Lazy load - only render when tab is active *@
                    @if (_selectedTabIndex == 1)
                    {
                        <Stage1Panel Responses="@Message.Stage1" />
                    }
                </ChildContent>
            </MudTabPanel>
            <MudTabPanel Disabled="@(Message.Stage2 == null || Message.Stage2.Count == 0)"
                         Icon="@Icons.Material.Filled.HowToVote">
                <TabContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="padding-right: 8px;">
                        <span>Rankings</span>
                        @if (Message.Stage2?.Count > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">
                                @Message.Stage2.Count
                            </MudChip>
                        }
                    </MudStack>
                </TabContent>
                <ChildContent>
                    @* Lazy load - only render when tab is active *@
                    @if (_selectedTabIndex == 2)
                    {
                        <Stage2Panel Rankings="@Message.Stage2"
                                     LabelToModel="@Message.Metadata?.LabelToModel"
                                     AggregateRankings="@Message.Metadata?.AggregateRankings" />
                    }
                </ChildContent>
            </MudTabPanel>
        </MudTabs>
    </MudStack>
}

@code {
    [Parameter]
    public AssistantMessage? Message { get; set; }

    [Parameter]
    public string? Query { get; set; }

    [Parameter]
    public DateTime Timestamp { get; set; } = DateTime.UtcNow;

    private int _selectedTabIndex = 0; // Default to Final Answer tab

    protected override void OnParametersSet()
    {
        // If we have a final answer, default to showing it
        if (Message?.Stage3 != null)
        {
            _selectedTabIndex = 0; // Final Answer is first tab
        }
        else if (Message?.Stage1 != null && Message.Stage1.Count > 0)
        {
            _selectedTabIndex = 1; // Responses tab
        }
    }

    private string GetLoadingMessage()
    {
        if (Message?.Loading == null)
            return "Processing...";

        if (Message.Loading.Stage1)
            return "Collecting responses from AI models...";
        if (Message.Loading.Stage2)
            return "Models are peer-reviewing responses...";
        if (Message.Loading.Stage3)
            return "Chairman is synthesizing the final answer...";

        return "Processing...";
    }

    private int GetCurrentStep()
    {
        if (Message?.Loading == null) return 0;
        if (Message.Loading.Stage1) return 1;
        if (Message.Loading.Stage2) return 2;
        if (Message.Loading.Stage3) return 3;
        return 0;
    }

    private bool IsStepComplete(int step)
    {
        var currentStep = GetCurrentStep();
        return step < currentStep;
    }

    private bool IsStepActive(int step)
    {
        return step == GetCurrentStep();
    }

    private Color GetStepColor(int step)
    {
        if (IsStepComplete(step)) return Color.Success;
        if (IsStepActive(step)) return Color.Primary;
        return Color.Default;
    }

    private Variant GetStepVariant(int step)
    {
        if (IsStepComplete(step) || IsStepActive(step)) return Variant.Filled;
        return Variant.Outlined;
    }

    private Color GetStepTextColor(int step)
    {
        if (IsStepActive(step)) return Color.Primary;
        if (IsStepComplete(step)) return Color.Success;
        return Color.Secondary;
    }
}

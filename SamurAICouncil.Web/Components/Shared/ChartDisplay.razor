@using SamurAICouncil.Core.Models
@using SamurAICouncil.Core.Interfaces
@using CoreChartType = SamurAICouncil.Core.Models.ChartType
@inject IChartDataTransformer ChartTransformer

@if (Chart != null && Chart.Type != CoreChartType.None && HasValidData())
{
    <MudPaper Class="pa-3 mt-3" Elevation="0" Style="background-color: var(--mud-palette-surface);">
        @if (!string.IsNullOrEmpty(Chart.Title))
        {
            <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight: 500;">
                <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Small" Class="mr-1" />
                @Chart.Title
            </MudText>
        }

        <div class="chart-container" style="width: 100%;">
            @switch (Chart.Type)
            {
                case CoreChartType.Bar:
                    <MudChart ChartType="MudBlazor.ChartType.Bar"
                              ChartSeries="@GetChartSeries()"
                              XAxisLabels="@Chart.Labels"
                              Width="100%"
                              Height="@GetBarChartHeight()"
                              ChartOptions="@_barOptions"
                              AxisChartOptions="@GetBarAxisOptions()" />
                    break;

                case CoreChartType.Line:
                    <MudChart ChartType="MudBlazor.ChartType.Line"
                              ChartSeries="@GetChartSeries()"
                              XAxisLabels="@Chart.Labels"
                              Width="100%"
                              Height="300px"
                              ChartOptions="@_lineOptions"
                              AxisChartOptions="@_lineAxisOptions" />
                    break;

                case CoreChartType.Pie:
                    <MudChart ChartType="MudBlazor.ChartType.Pie"
                              InputData="@GetPieData()"
                              InputLabels="@Chart.Labels"
                              Width="300px"
                              Height="300px" />
                    break;

                case CoreChartType.Donut:
                    <MudChart ChartType="MudBlazor.ChartType.Donut"
                              InputData="@GetPieData()"
                              InputLabels="@Chart.Labels"
                              Width="300px"
                              Height="300px" />
                    break;
            }
        </div>

        @if (!string.IsNullOrEmpty(Chart.XAxisLabel) || !string.IsNullOrEmpty(Chart.YAxisLabel))
        {
            <MudStack Row="true" Spacing="4" Class="mt-2" Justify="Justify.Center">
                @if (!string.IsNullOrEmpty(Chart.XAxisLabel))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        X: @Chart.XAxisLabel
                    </MudText>
                }
                @if (!string.IsNullOrEmpty(Chart.YAxisLabel))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Y: @Chart.YAxisLabel
                    </MudText>
                }
            </MudStack>
        }
    </MudPaper>
}

@code {
    [Parameter]
    public ChartRecommendation? Chart { get; set; }

    private readonly ChartOptions _barOptions = new()
    {
        YAxisTicks = 5,
        MaxNumYAxisTicks = 10
    };

    private readonly ChartOptions _lineOptions = new()
    {
        YAxisTicks = 5,
        MaxNumYAxisTicks = 10,
        LineStrokeWidth = 2
    };

    private readonly AxisChartOptions _lineAxisOptions = new()
    {
        XAxisLabelRotation = 0
    };

    /// <summary>
    /// Gets axis options for bar charts, applying rotation for long labels.
    /// </summary>
    private AxisChartOptions GetBarAxisOptions()
    {
        var shouldRotate = ChartTransformer.ShouldUseHorizontalBar(Chart);

        return new AxisChartOptions
        {
            // Rotate labels 30 degrees if they're long to prevent overlap
            XAxisLabelRotation = shouldRotate ? 30 : 0
        };
    }

    /// <summary>
    /// Gets appropriate height for bar chart based on label rotation.
    /// </summary>
    private string GetBarChartHeight()
    {
        // Slight height increase when labels are rotated (30°) to accommodate angled text
        var shouldRotate = ChartTransformer.ShouldUseHorizontalBar(Chart);
        return shouldRotate ? "320px" : "300px";
    }

    private bool HasValidData()
    {
        if (Chart == null)
            return false;

        if (Chart.Type is CoreChartType.Pie or CoreChartType.Donut)
        {
            return Chart.Series.Length > 0 &&
                   Chart.Series[0].Values.Length > 0 &&
                   Chart.Labels.Length > 0;
        }

        return Chart.Series.Length > 0 &&
               Chart.Series.Any(s => s.Values.Length > 0);
    }

    private List<ChartSeries> GetChartSeries()
    {
        if (Chart?.Series == null)
            return new List<ChartSeries>();

        return Chart.Series.Select(s => new ChartSeries
        {
            Name = s.Name,
            Data = s.Values
        }).ToList();
    }

    private double[] GetPieData()
    {
        if (Chart?.Series == null || Chart.Series.Length == 0)
            return Array.Empty<double>();

        // For pie/donut charts, use the first series values
        return Chart.Series[0].Values;
    }
}

@using SamurAICouncil.Core.Models
@using CoreChartType = SamurAICouncil.Core.Models.ChartType

@inject IExportService ExportService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

@if (Response == null || string.IsNullOrEmpty(Response.Response))
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Icon="@Icons.Material.Filled.Info">
        No final response available
    </MudAlert>
}
else
{
    <MudStack Spacing="2">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                Stage 3: Final Synthesis
            </MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                @if (Response.UsedTools)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Build" Size="Size.Small" Color="Color.Inherit" Title="Used tools" />
                }
                @if (Message != null && !string.IsNullOrEmpty(Query))
                {
                    @if (_isExportingPdf)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                    }
                    else
                    {
                        <MudTooltip Text="Export to PDF">
                            <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="ExportToPdf" />
                        </MudTooltip>
                    }
                    @if (ExportService.HasTabularData(Message))
                    {
                        @if (_isExportingExcel)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                        }
                        else
                        {
                            <MudTooltip Text="Export to Excel">
                                <MudIconButton Icon="@Icons.Material.Filled.TableChart"
                                               Size="Size.Small"
                                               Color="Color.Inherit"
                                               OnClick="ExportToExcel" />
                            </MudTooltip>
                        }
                    }
                }
                <MudChip T="string"
                         Size="Size.Small"
                         Color="Color.Primary"
                         Variant="Variant.Filled"
                         Icon="@Icons.Material.Filled.Person">
                    Chairman: @GetShortModelName(Response.Model)
                </MudChip>
            </MudStack>
        </MudStack>

        @if (Response.UsedTools)
        {
            <ToolUsagePanel ToolUsages="@Response.ToolUsages" />
        }

        <MudPaper Class="pa-4"
                  Elevation="0"
                  Style="border-left: 3px solid var(--mud-palette-primary);">
            <MarkdownRenderer Content="@Response.Response" />
        </MudPaper>

        @* Display chart in collapsible panel if available *@
        @if (Response.Chart != null && Response.Chart.Type != CoreChartType.None)
        {
            <MudExpansionPanels Class="mt-3" Elevation="0">
                <MudExpansionPanel @bind-Expanded="_chartExpanded"
                                   Dense="true"
                                   Style="background-color: var(--mud-palette-surface);">
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.BarChart"
                                     Size="Size.Small"
                                     Color="Color.Primary" />
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">
                                @(string.IsNullOrEmpty(Response.Chart.Title) ? "Chart Visualization" : Response.Chart.Title)
                            </MudText>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined"
                                     Color="Color.Primary">
                                @Response.Chart.Type
                            </MudChip>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <ChartDisplay Chart="@Response.Chart" />
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </MudStack>
}

@code {
    [Parameter]
    public Stage3Response? Response { get; set; }

    [Parameter]
    public AssistantMessage? Message { get; set; }

    [Parameter]
    public string? Query { get; set; }

    [Parameter]
    public DateTime Timestamp { get; set; } = DateTime.UtcNow;

    private bool _isExportingPdf = false;
    private bool _isExportingExcel = false;
    private bool _chartExpanded = true;  // Default to expanded

    private async Task ExportToPdf()
    {
        if (Message == null || string.IsNullOrEmpty(Query))
            return;

        try
        {
            _isExportingPdf = true;
            StateHasChanged();

            var pdfBytes = await ExportService.ExportToPdfAsync(Message, Query, Timestamp);
            var base64 = Convert.ToBase64String(pdfBytes);
            var filename = ExportService.GenerateFilename("pdf", Timestamp);

            await JS.InvokeVoidAsync("downloadFile", filename, "application/pdf", base64);

            Snackbar.Add("PDF exported successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF export failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExportingPdf = false;
            StateHasChanged();
        }
    }

    private async Task ExportToExcel()
    {
        if (Message == null || string.IsNullOrEmpty(Query))
            return;

        try
        {
            _isExportingExcel = true;
            StateHasChanged();

            var excelBytes = await ExportService.ExportToExcelAsync(Message, Query, Timestamp);
            var base64 = Convert.ToBase64String(excelBytes);
            var filename = ExportService.GenerateFilename("xlsx", Timestamp);

            await JS.InvokeVoidAsync("downloadFile", filename, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);

            Snackbar.Add("Excel exported successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Excel export failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExportingExcel = false;
            StateHasChanged();
        }
    }

    private static string GetShortModelName(string model)
    {
        if (string.IsNullOrEmpty(model))
            return "Unknown";

        var parts = model.Split('/');
        var modelPart = parts.Length > 1 ? parts[^1] : model;

        return modelPart switch
        {
            var m when m.StartsWith("gpt-4o") => "GPT-4o",
            var m when m.StartsWith("gpt-4") => "GPT-4",
            var m when m.StartsWith("gpt-3.5") => "GPT-3.5",
            var m when m.StartsWith("claude-3-opus") => "Claude Opus",
            var m when m.StartsWith("claude-3-sonnet") => "Claude Sonnet",
            var m when m.StartsWith("claude-3.5-sonnet") => "Claude 3.5",
            var m when m.StartsWith("claude-sonnet-4") => "Claude Sonnet 4",
            var m when m.StartsWith("claude-3-haiku") => "Claude Haiku",
            var m when m.StartsWith("gemini-2") => "Gemini 2.0",
            var m when m.StartsWith("gemini-1.5-pro") => "Gemini 1.5 Pro",
            var m when m.StartsWith("gemini-1.5-flash") => "Gemini 1.5 Flash",
            var m when m.StartsWith("gemini-pro") => "Gemini Pro",
            var m when m.StartsWith("gemini-1.5") => "Gemini 1.5",
            _ => modelPart.Length > 20 ? modelPart[..20] + "..." : modelPart
        };
    }
}

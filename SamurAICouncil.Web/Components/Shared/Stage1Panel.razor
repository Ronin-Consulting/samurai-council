@if (Responses == null || Responses.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Icon="@Icons.Material.Filled.Info">
        No responses available
    </MudAlert>
}
else
{
    <MudStack Spacing="2">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.QuestionAnswer" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                Stage 1: Individual Responses
            </MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                @Responses.Count models responded
            </MudChip>
        </MudStack>

        <MudTabs @bind-ActivePanelIndex="_selectedIndex"
                 Elevation="0"
                 Rounded="true"
                 ApplyEffectsToContainer="true"
                 PanelClass="pa-3"
                 MinimumTabWidth="100px">
            @foreach (var (response, index) in Responses.Select((r, i) => (r, i)))
            {
                <MudTabPanel Text="@GetShortModelName(response.Model)">
                    <TabContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAvatar Size="Size.Small" Color="@GetProviderColor(response.Model)">
                                @GetProviderInitial(response.Model)
                            </MudAvatar>
                            <span>@GetShortModelName(response.Model)</span>
                            @if (response.UsedTools)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Build" Size="Size.Small" Color="Color.Inherit" Title="Used tools" />
                            }
                        </MudStack>
                    </TabContent>
                    <ChildContent>
                        @if (response.UsedTools)
                        {
                            <ToolUsagePanel ToolUsages="@response.ToolUsages" />
                        }
                        <MudPaper Class="pa-4" Elevation="0" Style="background-color: var(--mud-palette-background-gray);">
                            <MarkdownRenderer Content="@response.Response" />
                        </MudPaper>
                    </ChildContent>
                </MudTabPanel>
            }
        </MudTabs>
    </MudStack>
}

@code {
    [Parameter]
    public List<Stage1Response>? Responses { get; set; }

    private int _selectedIndex;

    protected override void OnParametersSet()
    {
        if (Responses != null && _selectedIndex >= Responses.Count)
            _selectedIndex = 0;
    }

    private static string GetShortModelName(string model)
    {
        if (string.IsNullOrEmpty(model))
            return "Unknown";

        var parts = model.Split('/');
        var modelPart = parts.Length > 1 ? parts[^1] : model;

        return modelPart switch
        {
            var m when m.StartsWith("gpt-4") => "GPT-4",
            var m when m.StartsWith("gpt-3.5") => "GPT-3.5",
            var m when m.StartsWith("claude-3-opus") => "Claude Opus",
            var m when m.StartsWith("claude-3-sonnet") => "Claude Sonnet",
            var m when m.StartsWith("claude-3.5-sonnet") => "Claude 3.5",
            var m when m.StartsWith("claude-3-haiku") => "Claude Haiku",
            var m when m.StartsWith("gemini-pro") => "Gemini Pro",
            var m when m.StartsWith("gemini-1.5") => "Gemini 1.5",
            _ => modelPart.Length > 15 ? modelPart[..15] + "..." : modelPart
        };
    }

    private static string GetProviderInitial(string model)
    {
        if (string.IsNullOrEmpty(model)) return "?";

        var provider = model.Split('/').FirstOrDefault()?.ToLower() ?? "";
        return provider switch
        {
            "openai" => "O",
            "anthropic" => "A",
            "google" => "G",
            _ => model[..1].ToUpper()
        };
    }

    private static Color GetProviderColor(string model)
    {
        if (string.IsNullOrEmpty(model)) return Color.Default;

        // Use neutral colors to maintain Ronin theme consistency
        // All providers use Secondary (gray) for a unified look
        var provider = model.Split('/').FirstOrDefault()?.ToLower() ?? "";
        return provider switch
        {
            "openai" => Color.Dark,
            "anthropic" => Color.Primary,
            "google" => Color.Secondary,
            _ => Color.Secondary
        };
    }
}

@inherits Microsoft.AspNetCore.Components.Web.ErrorBoundary

@if (CurrentException is not null)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 300px;">
        <MudPaper Class="pa-6" Elevation="3" Style="text-align: center; max-width: 400px;">
            <MudAvatar Color="Color.Error" Size="Size.Large" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" />
            </MudAvatar>

            <MudText Typo="Typo.h6" Class="mb-2">Something went wrong</MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                @GetUserFriendlyMessage()
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="@Recover">
                Try Again
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else
{
    @ChildContent
}

@code {
    [Inject] private ILogger<AppErrorBoundary> Logger { get; set; } = null!;

    protected override Task OnErrorAsync(Exception exception)
    {
        Logger.LogError(exception, "Unhandled exception in component: {Message}", exception.Message);
        return base.OnErrorAsync(exception);
    }

    private string GetUserFriendlyMessage()
    {
        return CurrentException switch
        {
            HttpRequestException => "Unable to connect to the server. Please check your connection and try again.",
            TimeoutException => "The request timed out. Please try again.",
            InvalidOperationException ex when ex.Message.Contains("circuit") => "Connection lost. Please refresh the page.",
            _ => "An unexpected error occurred. Please try again or refresh the page."
        };
    }
}

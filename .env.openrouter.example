# ============================================================
# SamurAI Council - OpenRouter / open-source-models profile
# ============================================================
# An ALTERNATE, opt-in profile that routes every council agent role through
# OpenRouter (https://openrouter.ai) instead of the default FortyAU gateway,
# using open-source models. It coexists with the default `.env` — nothing
# about the default profile changes.
#
# Setup:
#   cp .env.openrouter.example .env.openrouter
#   # then set OPENAI_API_KEY below to your OpenRouter key
#
# Usage:
#   docker compose --env-file .env.openrouter up -d --build
#   (or: ./scripts/dev-up.sh up openrouter)
#
# Revert to the default (FortyAU) profile any time with a plain:
#   docker compose up -d --build
# ============================================================

# ----------------------------------------------------------
# OpenRouter credentials (reuses the "OpenAI" key/provider — the app always
# talks to whichever OpenAI-compatible endpoint is configured below)
# ----------------------------------------------------------

# Your OpenRouter API key. Get one at: https://openrouter.ai/keys
OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here

# OpenRouter's OpenAI-compatible endpoint (do not change unless you're
# pointing at a different OpenAI-compatible server).
OPENAI_API_ENDPOINT=https://openrouter.ai/api/v1

# Optional: cap the OpenAI SDK's built-in retry count (default: 3 retries / 4 total attempts,
# each up to ~100s). A stuck/dead call on a less-reliable open-weight endpoint can otherwise
# block for ~400s before the pipeline's graceful degradation (missing ranking / chairman
# fallback) kicks in. Set to 1 to fail in ~200s instead. Leave unset for SDK defaults.
OPENAI_MAX_RETRIES=1

# Optional: override the OpenAI SDK's per-attempt network timeout (default: 100s). Usually
# not needed — the default is activity-based (an attempt that's still receiving data can run
# well past 100s), so OPENAI_MAX_RETRIES is the more useful knob for a stuck/silent call.
# OPENAI_NETWORK_TIMEOUT_SECONDS=100

# ----------------------------------------------------------
# Model mapping - open-source models, one per agent role
# (Chosen and tuned from production testing — see docs/implementation-review.md and
# CLAUDE.md's "Trying open-source models via OpenRouter" section for the reasoning.)
#
# Each role also accepts an optional *_TEMPERATURE (0.0-2.0; lower = more deterministic/
# focused, higher = more varied) — only applied when set, so leaving it commented out uses
# the model's own default. Uncomment and tune per role, e.g. low for schema-precision-critical
# SQL generation, higher for creative/diverse council responses.
# ----------------------------------------------------------

# Council members (Stage 1 - independent responses)
COUNCIL_MODEL_0_ID=z-ai/glm-5.2
COUNCIL_MODEL_0_NAME=GLM 5.2
# COUNCIL_MODEL_0_TEMPERATURE=0.7
COUNCIL_MODEL_1_ID=minimax/minimax-m2.7
COUNCIL_MODEL_1_NAME=MiniMax M2.7
# COUNCIL_MODEL_1_TEMPERATURE=0.7
COUNCIL_MODEL_2_ID=qwen/qwen3.7-max
COUNCIL_MODEL_2_NAME=Qwen3.7 Max
# COUNCIL_MODEL_2_TEMPERATURE=0.7

# Chairman (Stage 3 - synthesizes the final answer)
CHAIRMAN_MODEL_ID=deepseek/deepseek-v4-pro
CHAIRMAN_MODEL_NAME=DeepSeek V4 Pro
# CHAIRMAN_MODEL_TEMPERATURE=0.5

# Title generation (lightweight - reuses the chairman's lab for a cheap/fast sibling model)
TITLEGEN_MODEL_ID=deepseek/deepseek-v4-flash
TITLEGEN_MODEL_NAME=DeepSeek V4 Flash
# TITLEGEN_MODEL_TEMPERATURE=0.3

# SQL generation for Text-to-SQL (a dedicated coder model — precision on schema/column names
# matters more here than general chat ability)
SQLGEN_MODEL_ID=qwen/qwen3-coder-next
SQLGEN_MODEL_NAME=Qwen3 Coder Next (SQL)
# SQLGEN_MODEL_TEMPERATURE=0.1

# ----------------------------------------------------------
# Everything else (Anthropic/Google keys, SQL Server password) falls back to
# compose.yaml's existing defaults and does not need to be set here.
# ----------------------------------------------------------

# ============================================================
# SamurAI Council - Environment Variables
# ============================================================
# Copy this file to .env and replace the placeholders with
# your actual API keys:
#
#   cp .env.example .env
#
# These variables are consumed by docker compose and can also
# be exported in your shell for local development.
# ============================================================

# ----------------------------------------------------------
# LLM Provider API Keys
# ----------------------------------------------------------

# OpenAI API Key (required)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (required)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google AI API Key (optional - needed if using Gemini models)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ----------------------------------------------------------
# SQL Server (optional - for ContosoRetailDW / Text-to-SQL)
# ----------------------------------------------------------

# SQL Server SA password (default shown below)
# MSSQL_SA_PASSWORD=YourStrong!Passw0rd
